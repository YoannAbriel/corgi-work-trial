# Corgi work trial, Track 1. Copy to .env.local and fill in. Never commit .env.local.
# Sandbox and test-mode credentials only (AF-04). Sandbox keys are still secrets (AF-05).

# --- Database (Neon Postgres) ---
# Owner connection, used only by the migration runner and the seed script.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Runtime connection for the app: the role app_runtime, created by migration 0001 with no UPDATE/DELETE/TRUNCATE
# on money tables. Required: the app refuses to start without it and never falls back to the owner connection.
# Setup order: run `npm run migrate` with DATABASE_URL, then `npm run set-runtime-role-password`, then fill this in.
DATABASE_URL_APP=postgresql://app_runtime:PASSWORD@HOST/neondb?sslmode=require
# Password given to app_runtime by `npm run set-runtime-role-password`. Generate: openssl rand -hex 24
APP_RUNTIME_DB_PASSWORD=REPLACE_ME
# Disposable test database (same Neon project, created with `create database corgi_test`), used by the checks
# that must commit rows: npm run check:ledger-seal and npm run check:payment-replay. Never the trial database
# (financial rows can never be deleted). Migrate it with: npm run migrate -- --database=test
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST/corgi_test?sslmode=require
DATABASE_URL_TEST_APP=postgresql://app_runtime:PASSWORD@HOST/corgi_test?sslmode=require

# --- Stripe (test mode sandbox, premium collection and refunds) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Signing secret of the webhook endpoint for this environment: on Vercel, the endpoint registered on the
# deployed URL (/api/webhooks/stripe); locally, the secret printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Broker KYB ---
# Runs on Stripe Connect Accounts v2 business verification in test mode (DECISIONS.md, 2026-09-08): the same
# STRIPE_SECRET_KEY above is used, no other provider credential is needed.

# --- Application ---
# Public base URL of the deployment, used for Stripe return URLs and document links.
APP_BASE_URL=http://localhost:3000
# 32+ random bytes, base64. Signs the session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=REPLACE_ME
# Shared secret for the job endpoints (/api/jobs/*). Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=REPLACE_ME
# Password given to the seeded demo users (broker, customer, staff_ops, staff_approver). Synthetic, shared with the panel.
DEMO_PASSWORD=REPLACE_ME
